        <update>plot count lymphocytes with [color = 115]</update>
      </pen>
      <pen interval="1.0" mode="0" display="pen-12" color="-5825686" legend="true">
        <setup></setup>
        <update>plot count lymphocytes with [color = 125]</update>
      </pen>
      <pen interval="1.0" mode="0" display="pen-13" color="-2064490" legend="true">
