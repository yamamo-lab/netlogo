        <update>plot count lymphocytes with [color = 135]</update>
      </pen>
    </plot>
    <button x="11" y="10" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="77" display="セットアップ">setup</button>
    <button x="90" y="10" height="40" disableUntilTicks="true" forever="true" kind="Observer" width="124" display="実行/一時停止">go</button>
    <button x="7" y="120" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="79" display="抗原A">insert-antigens</button>
