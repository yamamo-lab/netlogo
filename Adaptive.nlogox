    <plot x="275" autoPlotX="false" yMax="140.0" autoPlotY="false" yAxis="相対値" y="266" xMin="0.0" height="229" legend="false" xMax="100.0" yMin="0.0" width="324" xAxis="時間" display="抗原量">
      <setup></setup>
