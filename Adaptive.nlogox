<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[globals [
  death-rate
  reg-repro
  antibody-movement
  infected
  infected-b
  active-color
  active-color-b
  ; 以下は実習条件として固定する設定値
  antibody-effectiveness
  antigen-load
  vaccine-load
  reproduction-multiplier-when-active 
]
; death-rate = chance of the turtle dying
; antibody-movement = how many spaces the antibody has moved
; reg-repro = the chance a lymphocyte will reproduce when it is not active or a memory cell
; infected = records whether antigens have been inputted
; active-color = the color of the lymphocyte that responds to antigen A
; active-color-b = the color of the lymphocyte that responds to antigen B

breed [lymphocytes lymphocyte]
breed [antigens antigen]          ; antigen A
breed [antigens-b antigen-b]      ; antigen B
breed [antibodies antibody]
breed [vaccines vaccine]

lymphocytes-own [
  active
  active-time
  reproduction-rate
  memory
]

antibodies-own [energy target-antigen]

vaccines-own [vaccine-duration]

;-----------------------------------------------------------
to setup
  clear-all
  clear-output
  ask patches [set pcolor white]
  set infected 0      ; at setup, the system is not infected with any antigens
  set infected-b 0
  ;--------------------------------------------------
  ; 実習条件
  ; 必要に応じて，以下の値を変更する
  ;--------------------------------------------------

  ; 抗体の有効性
  ; "high"：抗体は1 tickに10パッチ移動し，8 tick生存する
  ; "low" ：抗体は1 tickに5パッチ移動し，4 tick生存する
  set antibody-effectiveness "high"

  ; 抗原Aまたは抗原Bを1回導入するときの抗原数
  set antigen-load 50

  ; ワクチンを1回導入するときのワクチン粒子数
  set vaccine-load 25

  ; 活性化したB細胞の増殖率の倍率
  ; 3.0の場合，通常の増殖率15％が45％になる
  set reproduction-multiplier-when-active 3.0

  ;--------------------------------------------------
  
  set death-rate 15   ; values fit to give best response, no inherent meaning to these rates
  set reg-repro 15
 　set active-color yellow  ; 抗原Aに特異的なB細胞の色
 　set active-color-b pink ; 抗原Bに特異的なB細胞の色
  set-default-shape lymphocytes "circle"     ; lymphocytes are circles
  set-default-shape antigens "monster"       ; antigens are monsters
  set-default-shape antigens-b "monster"
  set-default-shape vaccines "monster"       ; vaccines are greyed-out monsters
  set-default-shape antibodies "Y"           ; antibodies are Y-shaped
  create-lymphocytes 250  ; create the lymphocytes, then initialize their variables
  [
    set color one-of remove red base-colors ; 赤色は抗体Bに使用するため，B細胞の色には使わない
    set active 0 ; all lymphocytes are initially inactive
    set active-time -1
    set reproduction-rate reg-repro ; all lymphocytes are initially inactive, so reproduce at regular rate
    set size 1.5  ; easier to see
    set label-color blue - 2
    setxy random-xcor random-ycor
    set memory 0
  ]
  reset-ticks
end
;----------------------------------------------------------------------
to go
  if not any? turtles [ stop ]
  replace-extinct
  ask antigens[
    move
    antigen-reproduce
  ]
  ask antigens-b [
   move
   antigen-reproduce
 ]
  ask lymphocytes [
    bind
    activated
    move
    reproduce
    lymph-death
  ]
  ask antibodies [
    antibody-move
    set energy energy - 1
    antibody-death
  ]
  vaccine-death
  antigen-extinct
  antigen-b-extinct
  tick
  if ticks = 50 [  ; 50 tickで一度停止する
    stop
  ]
  ; ここで2回目の抗原を入れ，再び「実行」を押す
  if ticks >= 100 [
   stop
  ]
 end
;-----------------------------------------------------------
to replace-extinct           ; this is a "rescue effect", if any lymphocyte types (colors) go extinct we add one more to the population
  let counter 5
  while [counter < 140]      ; check all the colors
  [
; 赤色は抗体Bに使用するため，B細胞としては補充しない
if counter != red [
  if count lymphocytes with [color = counter] = 0 [
    create-lymphocytes 1 [
      set color counter
      set active-time -1
      set active 0
      set reproduction-rate reg-repro
      set size 1.5
      set label-color blue - 2
      setxy random-xcor random-ycor
      set memory 0

      ask n-of 1 lymphocytes [ die ]
    ]
  ]
]   
  set counter counter + 10
]
end
;--------------------------------------------------------
to move  ; antigen and lymphocyte procedure
  rt random 50
  lt random 50
  fd 1
end
;----------------------------------------------------;
to antigen-reproduce
   if random 100 < 20 and color != grey   ;; and statement keeps grey "vaccine antigens" from reproducing
    [
      hatch 1 [ rt random 360 fd 1]
    ]
end

;----------------------------------------------------
; active-color lymphocytes are activated by the antigen
to bind

  ; 抗原Aまたはワクチンに反応するB細胞
  if color = active-color [
    if (one-of antigens in-radius 1 != nobody)
       or (one-of vaccines in-radius 1 != nobody) [
      set active 1
      set active-time 10
    ]
  ]

  ; 抗原Bに反応するB細胞
  if color = active-color-b [
    if one-of antigens-b in-radius 1 != nobody [
      set active 1
      set active-time 10
    ]
  ]

end 
;---------------------------------------------------------------
to activated
  if active-time = 0                                 ; kills activated after time is up
    [
       die
      ]

  if active = 1
  [
    set reproduction-rate (reproduction-multiplier-when-active * reg-repro) ; start rapid reproduction
    set size 1.5               ; increase size
    set shape "bold-circle"  ; outline circle
    hatch-antibodies 2       ; create antibodies
     [
      ifelse color = active-color
      [
        set target-antigen 1
        set color black     ; 抗原Aに対する抗体は黒
      ]
      [
        set target-antigen 2
        set color red       ; 抗原Bに対する抗体は赤
      ]

      rt random-float 360 
      fd 1

      if antibody-effectiveness = "high"
      [
        ; 抗体の寿命（tick）
        ; 値を大きくすると，作られた抗体が長く残る
        set energy 15
      ]

      if antibody-effectiveness = "low"
      [
        set energy 4
      ]
    ]
   set active-time active-time - 1    ;; counts back down to inactivity
  ]
end
;-------------------------------------------------------------
to reproduce  ; determine if the lymphocyte reproduces

 if random 100 < reproduction-rate
  [ ifelse memory = 1
    [
      hatch 1 [
        ifelse random-float 1 < 0.2
        [  
          set shape "M-circle"
          set size 2.0
        ]
        [ 
          set shape "circle"
          set size 1.5
        ]

        rt random-float 360
        fd 1
      ]
    ]
    [
       ifelse active = 1 ; if active, produce both a memory cell and an active cell ; else, produce regular cell
        [
           hatch-lymphocytes 1 [ 
            ifelse random-float 1 < 0.2
            　[
              　set shape "M-circle" 
               set size 2.0 
            ]
            [ 
              set shape "circle" 
              set size 1.5
            ]

            set active 0
            set reproduction-rate 2
            set label-color blue - 2
            set memory 1
            rt random-float 360
            fd 1
          ]
          hatch 1 [ rt random-float 360 fd 1]
        ]
        [
            ifelse count lymphocytes < 235
               [
                        hatch 2 [ rt random-float 360 fd 1]
               ]
                [
                        hatch 1 [ rt random-float 360 fd 1]
                 ]
        ]
    ]
  ]
end
;-------------------------------------------------------------
to lymph-death  ; determine if the lymphocyte dies
  if memory = 0 and random 100 < death-rate
      [
        die
      ]
  if memory = 1 and random 100 < 2
  [
    die
  ]
end
;----------------------------------------------------
to antibody-move  ; the speed (distance moved each time step) ends up being a measure of potency of each activated cell
  set antibody-movement 0
  if antibody-effectiveness = "high"
  [
     while [antibody-movement < 10]
     [fd 1
     kill-antigen  ; check to see if it is on the same spot as an antigen and if so, kill it
     set antibody-movement antibody-movement + 1
     ]
  ]

  if antibody-effectiveness = "low"
  [
     while [antibody-movement < 5]
     [fd 1
     kill-antigen
     set antibody-movement antibody-movement + 1
     ]
  ]
end
;----------------------------------------------------
to antibody-death
  if energy < 1
  [ die ]
end
;--------------------------------------------
to kill-antigen
  ; 抗原Aに対する抗体
  if target-antigen = 1 [
    let prey one-of antigens-here
    if prey != nobody [
      ask prey [ die ]
    ]
  ]

  ; 抗原Bに対する抗体
  if target-antigen = 2 [
    let prey one-of antigens-b-here
    if prey != nobody [
      ask prey [ die ]
    ]
  ]

end
;---------------------------------------------
to vaccine-death
  ask vaccines
  [
    move
    if vaccine-duration < 1 [die]
    set vaccine-duration vaccine-duration - 1
  ]
end
;-----------------------------------------------
to antigen-extinct
  if (count antigens = 0) and (infected = 1)
  [
     output-type "抗原A　排除時刻 "  output-print ticks
    set infected 0
  ]
end
;---------------------------------------------
to antigen-b-extinct
  if (count antigens-b = 0) and (infected-b = 1) [
    output-type "抗原B 排除時刻 "
    output-print ticks
    set infected-b 0
  ]
end
;---------------------------------------------
to insert-antigens                               ; create an infection every button push
  output-type "抗原A　感染時刻 "  output-print ticks
  set infected 1 ; noting that antigens have been put into the cell
    create-antigens antigen-load
    [
     set color black
     set size 2  ; easier to see
     set label-color blue - 2
     setxy random-xcor random-ycor
    ]

end
;----------------------------------------------
to infect-antigen-b
  output-type "抗原B 感染時刻 "
  output-print ticks
  
  set infected-b 1

  create-antigens-b antigen-load [
    set color red
    set size 2
    setxy random-xcor random-ycor
  ]
end
;----------------------------------------------
to insert-vaccine
  output-type "ワクチンA　接種時刻 "  output-print ticks
  create-vaccines vaccine-load
    [
     set color grey
     set size 2  ; easier to see
     set label-color blue - 2
     setxy random-xcor random-ycor
     set vaccine-duration 10
    ]
end]]></code>
