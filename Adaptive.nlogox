    <plot x="272" autoPlotX="false" yMax="8000.0" autoPlotY="false" yAxis="相対値" y="6" xMin="0.0" height="252" legend="false" xMax="100.0" yMin="0.0" width="323" xAxis="時間" display="抗体量">
