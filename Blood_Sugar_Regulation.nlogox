<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[; =============================================================================
; Blood Sugar Regulation - 高校「生物基礎」授業用改変版
;
; Original model:
; Woods, P. and Wilensky, U. (2017).
; NetLogo Blood Sugar Regulation model.
;
; 本版では、日本の高等学校「生物基礎」の血糖濃度調節の学習用に、
; 原モデルをもとに以下の変更を行っている。
;
; ・1 tick = 6分として時間表示
; ・正常安定状態を基準として血糖濃度、インスリン濃度、
;   グルカゴン濃度を教育用の単位に換算
; ・食後のグルコース流入を時間依存的な吸収曲線として表現
; ・インスリン感受性を変更してインスリン抵抗性を表現
; ・インスリン分泌能 によりインスリン分泌能を変更可能
; ・実行開始前に120分相当のならし計算を実施
;
; 詳細なモデルの説明、操作方法、生理学的な意味および限界については
; Model Info を参照。
; =============================================================================

globals [
  molecule-size     ; display scaling constant
  hormone-half-life
  hormone-mean-life
  eating?           ; keep track of meal state based on EAT button presses
  eat-time          ; keep track of ongoing meal duration
  total-glucose     ; storage variable to record combined blood and stored glucose
  glucose-baseline  ; average 'normal' number of glucoses in the blood per cell
  meal-size
  meal-length
  meal-profile-total
  meal-glucose-added
  initial-glucose-count
  initial-insulin-count
  initial-glucagon-count
  initial-liver-store
  basal-glucagon-secretion
  
  metabolic-rate
  glucose-sensitivity
  glucagon-sensitivity
  
  glucagon-display
  
  計算用インスリン感受性
  計算用インスリン分泌能  
  
]

; Set up different cell breeds.
; We need different cell types to behave differently.
; This is why cells are turtles rather than patches.
breed [ liver-cells liver-cell ]
breed [ pancreatic-cells pancreatic-cell ]

; Set up different molecule breeds
breed [ glucoses glucose ]
breed [ insulins insulin ]
breed [ glucagons glucagon ]

liver-cells-own [ glucose-store ]
insulins-own [ lifetime ]
glucagons-own [ lifetime ]

;-------------- set up ---------------------------------------------------------
to setup

  let saved-meal 食事
  clear-all
  set 食事 saved-meal

  ; Fixed parameters
	set metabolic-rate 70
	set glucose-sensitivity 100
	set glucagon-sensitivity 0.75
  
  ; Initial stabilization is always performed normally
  set 計算用インスリン感受性 100
  set 計算用インスリン分泌能 100
  
  set-default-shape turtles "circle outline"
  set molecule-size 0.25
  set eat-time 0
  set eating? false

  ; These values are calibrated to establish a reasonable correspondence for
  ; energy density and time between the model and the real world system.
  ; See the comment at the top of the file for more information.
  set glucose-baseline 3 ; Controls the normal blood glucose level.
  set hormone-half-life 2.33 ; Corresponds to 14 minutes, roughly twice insulin.
  set hormone-mean-life hormone-half-life / ln 2 ; From exponential distribution.
  set meal-size 36000 ; Total glucose particles supplied by one meal (adjustable for teaching).
  set meal-length 70 ; 70 ticks x 6 min = 420 min, following the time range of Rizza Fig. 3.
  set basal-glucagon-secretion 0.8

  ; Fig. 3-inspired intestinal absorption profile.
  ; Meal-derived glucose appearance rises rapidly after ingestion, peaks around
  ; 40-50 min, then declines gradually for several hours.
  set meal-profile-total 0
  let profile-tick 0
  while [profile-tick < meal-length] [
    set meal-profile-total meal-profile-total + meal-absorption-weight profile-tick
    set profile-tick profile-tick + 1
  ]
  set meal-glucose-added 0

  ; Set up organs
  make-liver
  make-pancreas
  ;set initial-liver-store sum [glucose-store] of liver-cells

  let world-area (2 * max-pxcor + 1) * (2 * max-pycor + 1)

  ; Make initial molecules at approximately their stable concentrations.
  create-glucoses world-area * (glucose-baseline + 1) [
    random-position
    set color white
    set size molecule-size
  ]
  ;set initial-glucose-count count glucoses
  ; Hormones typically follow exponential decay, so their lifetimes
  ; are randomly drawn from an exponential distribution. This also
  ; makes the least assumptions, since the exponential distribution
  ; is the maximum-entropy distribution for a fixed, positive mean.
  create-insulins round (world-area / 3) [
    random-position
    set color sky
    set size molecule-size * 2
    set lifetime random-exponential hormone-mean-life
  ]
  ;set initial-insulin-count count insulins
  create-glucagons round (world-area / 3) [
    random-position
    set color red
    set size molecule-size * 2
    set lifetime random-exponential hormone-mean-life
  ]
  ;set initial-glucagon-count count glucagons
  ; keep track of the body's fuel
  set total-glucose (count glucoses) + sum ([glucose-store] of liver-cells)

  ; 食事なしでモデルを安定化
	stabilize

	; 安定状態を正常時の基準値とする
	set initial-glucose-count count glucoses
	set initial-insulin-count count insulins
	set initial-glucagon-count count glucagons
	set initial-liver-store sum [glucose-store] of liver-cells
  set glucagon-display 150

	set eating? false
	set eat-time 0
  
  ; Restore the values selected by the user
	set 計算用インスリン感受性 インスリン感受性
	set 計算用インスリン分泌能 インスリン分泌能

  reset-ticks
end

;--------------- stabilize ------------------------------------------
to stabilize
  repeat 50 [
    ask liver-cells [ adjust-glucose ]
    ask pancreatic-cells [ adjust-hormones ]

    metabolize-glucose
    signal-degradation

    ask insulins [ move ]
    ask glucagons [ move ]
    ask glucoses [ move ]

    set total-glucose
      (count glucoses) + sum [glucose-store] of liver-cells
  ]
end

;--------------- go ------------------------------------
to go
  if (total-glucose = 0) [
    user-message "The body ran out of glucose."
    stop
  ]
  
  ; Stop at extreme hyperglycemia
  if blood-glucose-mgdl >= 400 [
    user-message "血糖濃度が400 mg/100mL以上になったため、シミュレーションを停止します。"
    stop
  ]

  ; Stop at severe hypoglycemia
  if blood-glucose-mgdl <= 50 [
    user-message "血糖濃度が50 mg/100mL以下になったため、シミュレーションを停止します。"
    stop
  ]

  ; Keeps track of the EAT button presses
  if eating? [ add-glucose ]

  ; Liver detects hormones and absorbs / releases glucose
  ask liver-cells [ adjust-glucose ]

  ; Pancreas detects glucose and maybe releases insulin / glucagon
  ask pancreatic-cells [ adjust-hormones ]

  metabolize-glucose
  signal-degradation

  ; Ask signals to move
  ask insulins [ move ]
  ask glucagons [ move ]
  ask glucoses [ move ]

  ; Keep track of the body's fuel
  set total-glucose (count glucoses) + sum ([glucose-store] of liver-cells)

  ; グルカゴン濃度の表示を平滑化
  let raw-glucagon glucagon-concentration
  set glucagon-display
    0.75 * glucagon-display
    + 0.25 * raw-glucagon

  tick
end

;----------- eat button ---------------
; Adds one meal's worth of glucose over the course of the defined meal time.

; Button procedure
; Either starts a new meal or extends a current meal.
; 設定された吸収時間にわたって、1回の食事に相当する量のグルコースを追加する。
to eat
  ; Start one oral glucose load at time zero.
  ; Pressing EAT again restarts the absorption profile for a new meal.
  set eating? true
  set eat-time meal-length
  set meal-glucose-added 0
end

; Implements a Fig. 3-inspired meal-derived glucose appearance profile.
; Instead of adding glucose at a constant rate, absorption rises rapidly,
; peaks around 40-50 min, and then declines gradually over several hours.
to add-glucose
  let meal-tick meal-length - eat-time
  let weight meal-absorption-weight meal-tick
  let glucose-to-add round (meal-size * weight / meal-profile-total)

  ; Rounding is corrected at the final tick so that one meal adds exactly meal-size.
  if eat-time = 1 [
    set glucose-to-add meal-size - meal-glucose-added
  ]
  set glucose-to-add max list 0 (min list glucose-to-add (meal-size - meal-glucose-added))

  create-glucoses glucose-to-add [
    random-position
    set color white
    set size molecule-size
  ]
  set meal-glucose-added meal-glucose-added + glucose-to-add

  set eat-time eat-time - 1
  if eat-time < 1 [ set eating? false ]
end

; Relative intestinal glucose appearance after oral glucose ingestion.
; Difference-of-exponentials approximation to the shape of Rizza (2010) Fig. 3:
; rapid rise, peak at about 45 min, then a long declining tail.
to-report meal-absorption-weight [meal-tick]
  if meal-tick <= 0 [ report 0 ]
  report (exp (- meal-tick / 40)) - (exp (- meal-tick / 2.5))
end

;------------ setup helpers ---------------

; Particle procedure
; Place molecule at random location
to random-position
  setxy (min-pxcor + random-float (max-pxcor * 2))
        (min-pycor + random-float (max-pycor * 2))
end

; Sets up liver cells
to make-liver
  ask patches with [ pxcor < round (max-pxcor / 2) ] [
    sprout-liver-cells 1 [
      set shape "square 2"
      set color brown + 2
      set glucose-store random-poisson 150 ; Enough to survive for about a week.
    ]
  ]
end

; Sets up pancreatic cells
to make-pancreas
  ask patches with [ pxcor >= round (max-pxcor / 2) ] [
    sprout-pancreatic-cells 1 [
      set shape "square 2"
      set color yellow - 1
    ]
  ]
end

; ----------- signal procedures ------------

; Molecule procedure
to move
  rt random 90
  lt random 90
  fd 1
end

; Observer procedure
to signal-degradation
  ask insulins [
    set lifetime lifetime - 1
    if (lifetime <= 0) [ die ]
  ]
  ask glucagons [
    set lifetime lifetime - 1
    if (lifetime <= 0) [ die ]
  ]
end

; Observer procedure
to metabolize-glucose
  ifelse (count glucoses >= metabolic-rate) [
    ask n-of metabolic-rate glucoses [ die ]
  ] [
    ask glucoses [ die ]
  ]
end

;---------------- cell procedures ---------------
; Both cell types implement signal sensitivity using the binomial distribution.
; In this context, each signal's sensitivity slider directly governs the
; probability that a cell will detect the presence of that signal when it is
; present. Lowering the sensitivity makes cells more likely to miss signals.
; The binomial distribution gives the probability that a cell will detect k signals
; when n signals are present, given a detection probability p for each signal.
; This can be used to produce likely signal counts (or k's) for a cell with n
; signal molecules present and a given signal sensitivity.

; Liver procedure
; Releases or sequesters glucose based on the local hormone concentrations.
;---------------- 細胞の処理 ----------------
; 2種類の細胞はいずれも、二項分布を用いてシグナルに対する感受性を表現する。
; このモデルでは、それぞれのシグナルに対する感受性スライダーの値が、
; そのシグナルが存在するときに、細胞がそれを検出する確率を直接決める。
; 感受性を低くすると、細胞はシグナルを見逃しやすくなる。
;
; 二項分布は、n個のシグナルが存在し、
; 各シグナルを検出する確率がpであるときに、
; 細胞がk個のシグナルを検出する確率を与える。
; これを用いることで、n個のシグナル分子が存在する細胞について、
; 指定されたシグナル感受性に応じた、もっともらしい検出シグナル数
; （kの値）を求めることができる。

; 肝細胞の処理
; 周囲のホルモン濃度に応じて、グルコースを放出または取り込む。
to adjust-glucose
	; Detect hormones according to a binomial distribution based on their sensitivities.
  let insulin-count random-binomial (count insulins-here)  (0.75 * 計算用インスリン感受性 / 100) ;インスリン感受性
  let glucagon-count random-binomial (count glucagons-here) glucagon-sensitivity

  ; A positive net signal means we release glucose.
  ; The stronger the signal (the larger the absolute value),
  ; the more glucose is released or sequestered.
  let net-signal glucagon-count - insulin-count

  ; If there is more glucagon signal than insulin signal, release glucose.
  if net-signal > 0 [
    ifelse (glucose-store >= net-signal) [
      ; If there is a lot of glucose stored in the cell, hatch new glucose molecules.
      hatch-glucoses net-signal [
        random-position
        set color white
        set size molecule-size
      ]
      ; Account for the change in stored glucose (net-signal > 0).
      set glucose-store glucose-store - net-signal
    ] [
      ; If there is not enough glucose stored in the cell, release as much as possible.
      hatch-glucoses glucose-store [
        random-position
        set color white
        set size molecule-size
      ]
      set glucose-store 0
    ]
  ]
  ; If there is more insulin signal than glucagon signal, sequester glucose.
  if net-signal < 0 [
    ifelse (count glucoses >= abs net-signal) [
      ; If there's a lot of blood glucose, sequester what you need (net-signal < 0).
      set glucose-store glucose-store - net-signal
      ask n-of abs net-signal glucoses [ die ]
    ] [
      ; If there's not ehough blood glucose, sequester as much as possible.
      set glucose-store glucose-store + count glucoses
      ask glucoses [ die ]
    ]
  ]
end

;------------------- adjust hormones --------------------------------------------------------------
; Pancreas procedure
; Produces hormones according to the local glucose concentration.

; Hormones typically follow exponential decay, so their lifetimes
; are randomly drawn from an exponential distribution. This also
; makes the least assumptions, since the exponential distribution
; is the maximum-entropy distribution for a fixed, positive mean.
; ホルモンは時間とともに指数関数的に減少するため、
; 各ホルモン分子の寿命には指数分布に従うばらつきをもたせる。
to adjust-hormones
  ; Detect glucose according to a binomial distribution based on the sensitivity.
  let glucose-count random-binomial (count glucoses-here) (0.75 * glucose-sensitivity / 100) ; glucose-sensitivity
  ; Signal strength is determined by the difference in concentration from normal.
  let signal-count abs (glucose-baseline - glucose-count)

  ; Basal glucagon secretion
  ;if random-float 1 < basal-glucagon-secretion [
    ;hatch-glucagons 1 [
      ;random-position
      ;set color red
      ;set size molecule-size * 2
      ;set lifetime random-exponential hormone-mean-life
    ;]
  ;]
  
; Basal glucagon secretion
; 高血糖時にはグルカゴンの基礎分泌を抑制する
let basal-glucagon-p basal-glucagon-secretion

if glucose-count > glucose-baseline [
  set basal-glucagon-p
    max (list 0.65
      (basal-glucagon-secretion
       - 0.05 * (glucose-count - glucose-baseline)))
]

let basal-glucagon-count
  random-binomial 2 basal-glucagon-p

if basal-glucagon-count > 0 [
  hatch-glucagons basal-glucagon-count [
    random-position
    set color red
    set size molecule-size * 2
    set lifetime random-exponential hormone-mean-life
  ]
]
  
  ; If there are too few glucoses...
  if (glucose-count < glucose-baseline) [
    ; Glucose-dependent additional glucagon secretion
  	let glucagon-signal-count random-binomial signal-count 0.25  ;^^^^^^^^^^^^^^^^^^^^^^

    ; ...release glucagon molecules.
    hatch-glucagons glucagon-signal-count [
      random-position
      set color red
      set size molecule-size * 2
      set lifetime random-exponential hormone-mean-life
    ]
  ]
  ; If there are too many glucoses... ;-----------------------------
  if (glucose-count > glucose-baseline) [
    ; ...release insulin molecules.
  	; Insulin secretion according to beta-cell function
  	let insulin-to-release
    	random-binomial signal-count (計算用インスリン分泌能 / 100)
    
    hatch-insulins insulin-to-release [  ;signal-count [  -----------
      random-position
      set color sky
      set size molecule-size * 2
      set lifetime random-exponential hormone-mean-life
    ]
  ]
end

;---------------- time ----------------

to-report elapsed-minutes
  report ticks * 6
end
;-----現在の粒子数 ÷ 初期粒子数 × 90 -------
to-report blood-glucose-mgdl
  if initial-glucose-count = 0 [ report 0 ]
  report 90 * count glucoses / initial-glucose-count
end

;---------------- concentration ----------------

to-report insulin-concentration
  if initial-insulin-count = 0 [ report 0 ]
  report 10 * count insulins / initial-insulin-count
end

to-report glucagon-concentration
  if initial-glucagon-count = 0 [ report 0 ]
  report 150 * count glucagons / initial-glucagon-count
end

to-report liver-storage-relative
  if initial-liver-store = 0 [ report 0 ]
  report 100 * sum [glucose-store] of liver-cells / initial-liver-store
end

;---------------- math helpers ----------------

; Returns the outcome of a Bernoulli trial with success probability p.
; Successes are reported as 1 and failures are reported as 0.
to-report random-bernoulli [ p ]
  report ifelse-value random-float 1 < p [1] [0]
end

; Returns a random number according to the binomial distribution with parameters n and p
; where n is the number of trials and p is the probability of success in each trial.
to-report random-binomial [n p]
  if (n < 0) or not (int n = n) [
    error "Input n must be a non-negative integer."
  ]
  if (p < 0) or (p > 1) [
    error "Probability p must be between 0 and 1."
  ]

  ; Sum the number of successes in n Bernoulli trials with success probability p.
  report sum n-values n [random-bernoulli p]
end

;----------- １２０分ならし ----------------
to equilibrate-120

  ; Remember whether the EAT button was pressed
  ; let meal-requested? eating?

  ; No meal during equilibration
  set eating? false
  set eat-time 0

  ; 20 steps x 6 min = 120 min
  ; Do the same calculations as go, but WITHOUT tick.
  repeat 20 [

    ask liver-cells [ adjust-glucose ]
    ask pancreatic-cells [ adjust-hormones ]

    metabolize-glucose
    signal-degradation

    ask insulins [ move ]
    ask glucagons [ move ]
    ask glucoses [ move ]

    set total-glucose
      (count glucoses) + sum [glucose-store] of liver-cells
  ]

  ; ならし計算終了時のグルカゴン濃度を表示の初期値とする
  set glucagon-display glucagon-concentration

  ; Start displayed simulation from time 0
  clear-all-plots
  reset-ticks
end

;----------- シミュレーション開始 ----------------
to run-simulation

  setup

  ; 感受性または分泌能が100%以外なら120分ならす
  if (インスリン感受性 != 100 or インスリン分泌能 != 100) [
    equilibrate-120
  ] 
  
  ; 食事ありの場合、ここから食事を開始
  if 食事 [
    eat
  ]

  ; 300分まで実行（1 tick = 6分）
  repeat 50 [
    go
  ]

end

;*****************************************************************
; Copyright 2017 Uri Wilensky.
; Original model: Woods, P. and Wilensky, U. (2017).
; NetLogo Blood Sugar Regulation model.
;
; Modified for Japanese high school biology education, 2026.
; Changes include Japanese labels, simplification of controls,
; and modification of graphs for teaching blood glucose regulation.
;
